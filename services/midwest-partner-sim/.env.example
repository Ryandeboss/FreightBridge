APP_ENV=development
DATABASE_URL=replace-with-supabase-postgres-connection-string
MIDWEST_API_BEARER_TOKEN=replace-with-midwest-write-token
MIDWEST_API_READONLY_TOKEN=replace-with-optional-midwest-readonly-token
