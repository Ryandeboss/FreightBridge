              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loadId\": \"LOAD500\",\n  \"decision\": \"REJECTED\",\n  \"carrierCode\": \"MWCX\",\n  \"message\": \"No available driver.\",\n  \"decidedAt\": \"2026-09-19T14:45:00Z\"\n}"
