            },
            "url": "{{apexBaseUrl}}/v1/load-tenders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('read-only write forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "404 unknown load",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apexBearerToken}}"
              }
            ],
            "url": "{{apexBaseUrl}}/v1/loads/LOAD999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unknown load not found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
